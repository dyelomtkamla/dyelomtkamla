@inject IConfiguration Config
@{
    var t = SiteText.For(Context.Request);
    var baseUrl = (Config["Site:BaseUrl"] is { Length: > 0 } u ? u : $"{Context.Request.Scheme}://{Context.Request.Host}").TrimEnd('/');
    var arPath = ViewData["ArPath"] as string ?? "/";
    var enPath = ViewData["EnPath"] as string ?? "/en";
    var selfPath = t.Lang == "en" ? enPath : arPath;
    var title = ViewData["Title"] as string ?? t.Title;
    var description = ViewData["Description"] as string ?? t.Description;
    var noIndex = ViewData["NoIndex"] is true;
}
<!DOCTYPE html>
<html lang="@t.Lang" dir="@t.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="keywords" content="@t.Keywords" />
    <meta name="robots" content="@(noIndex ? "noindex,follow" : "index,follow,max-image-preview:large")" />
    <meta name="theme-color" content="#0f5c4d" />
    <link rel="canonical" href="@baseUrl@selfPath" />
    <link rel="alternate" hreflang="ar" href="@baseUrl@arPath" />
    <link rel="alternate" hreflang="en" href="@baseUrl@enPath" />
    <link rel="alternate" hreflang="x-default" href="@baseUrl@arPath" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dar" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@baseUrl@selfPath" />
    <meta property="og:image" content="@baseUrl/img/og.png" />
    <meta property="og:locale" content="@t.Locale" />
    <meta property="og:locale:alternate" content="@(t.Lang == "ar" ? "en_US" : "ar_SA")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@baseUrl/img/og.png" />

    <link rel="icon" href="/img/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/icon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip" href="#main">@(t.Lang == "ar" ? "انتقل إلى المحتوى" : "Skip to content")</a>
    <header class="nav">
        <div class="wrap nav-in">
            <a class="brand" href="@t.Home" aria-label="Dar">
                <img src="/img/icon.svg" alt="" width="34" height="34" />
                <span>@(t.Lang == "ar" ? "دار" : "Dar")</span>
            </a>
            <nav aria-label="@(t.Lang == "ar" ? "الرئيسية" : "Main")">
                <a href="@t.Home#features">@t.NavFeatures</a>
                <a href="@t.Home#workers">@t.NavWorkers</a>
                <a href="@t.Home#faq">@t.NavFaq</a>
                <a class="lang" href="@(t.Lang == "ar" ? enPath : arPath)" hreflang="@(t.Lang == "ar" ? "en" : "ar")">@t.OtherLangLabel</a>
                <a class="btn btn-sm" href="@t.Home#join">@t.NavJoin</a>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="foot">
        <div class="wrap foot-in">
            <span>© @DateTime.UtcNow.Year @t.Footer</span>
            <a href="@t.PrivacyPath">@t.PrivacyLink</a>
        </div>
    </footer>
</body>
</html>
