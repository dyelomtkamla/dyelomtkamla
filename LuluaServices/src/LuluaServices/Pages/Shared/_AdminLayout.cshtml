@inject IOptions<BusinessOptions> BusinessOpts
@{
    var b = BusinessOpts.Value;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b3b4f" />
    <title>@(ViewData["Title"] ?? "لوحة التحكم") | @b.ShortName</title>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/admin.css" asp-append-version="true" />
</head>
<body class="admin">
    <header class="topbar">
        <div class="wrap admin-wrap topbar-in">
            <a class="brand" href="/admin">
                <img src="/img/logo.svg" width="38" height="38" alt="" />
                <span><b>لوحة التحكم</b><small>@b.ShortName</small></span>
            </a>
            @if (signedIn)
            {
                <form method="post" asp-page="/Admin/Logout">
                    <button class="btn btn-sm btn-outline" type="submit">تسجيل الخروج</button>
                </form>
            }
            else
            {
                <a class="btn btn-sm btn-outline" href="/">الموقع</a>
            }
        </div>
    </header>
    <main class="wrap admin-wrap">
        @RenderBody()
    </main>
    <script src="~/assets/admin.js" asp-append-version="true" defer></script>
</body>
</html>
